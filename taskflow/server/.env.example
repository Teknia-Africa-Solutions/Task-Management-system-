# ---- TaskFlow API config (copy to .env and edit) ----

# Server
PORT=4000
# Comma-separated list of allowed frontend origins (Vite dev server default shown)
CLIENT_ORIGIN=http://localhost:5173

# MySQL / MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=taskflow

# Auth
# CHANGE THIS to a long random string in any real deployment
JWT_SECRET=dev-only-change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Password for every seeded demo user (so you can log in as any of them)
SEED_PASSWORD=password123
