{
  "name": "taskflow-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TaskFlow REST API — Express + MySQL, JWT auth, role-based access, clock-in time tracking, weekly reports, real-time via Socket.IO",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "db:schema": "node db/run-schema.js",
    "db:seed": "node db/seed.js",
    "db:reset": "node db/run-schema.js && node db/seed.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.11.5",
    "socket.io": "^4.8.1"
  }
}
